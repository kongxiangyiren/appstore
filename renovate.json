{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],
  "gitIgnoredAuthors": ["githubaction@githubaction.com"],
  "rebaseWhen": "never",
  "prCreation": "immediate",
  "dependencyDashboard": {
    "enabled": true
  },
  "mode": "full",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "matchFileNames": ["apps/neko/firefox/*.yml"],
      "allowedVersions": "firefox"
    },
    {
      "matchFileNames": ["apps/music-tag-web/2.*/*.yml"],
      "allowedVersions": "/^2.*/"
    },
    {
      "matchFileNames": ["apps/act_runner/**/*.yml"],
      "versioning": "docker",
      "allowedVersions": ">=6.0.0 <7.0.0"
    }
  ]
}
