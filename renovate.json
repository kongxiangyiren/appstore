{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitIgnoredAuthors": ["githubaction@githubaction.com"],
  "mode": "full",
  "automerge": true,
  "rebaseWhen": "never",
  "packageRules": [
    {
      "matchPackageNames": ["github-actions"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "registryUrls": ["https://docker.1ms.run/"]
    },
    {
      "matchPackageNames": ["docker-compose"],
      "automerge": true
    },
    {
      "matchFileNames": ["apps/neko/firefox/*.yml"],
      "allowedVersions": "firefox"
    },
    {
      "matchFileNames": ["apps/music-tag-web/2.*/*.yml"],
      "allowedVersions": "/^2.*/"
    },
    {
      "matchFileNames": ["apps/act_runner/0.*/*.yml"],
      "allowedVersions": "/^0.*/"
    }
  ],
  "prCreation": "immediate"
}
