{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitIgnoredAuthors": ["githubaction@githubaction.com"],
  "rebaseWhen": "never",
  "prCreation": "immediate",
  "packageRules": [
    {
      "matchPackageNames": ["github-actions"],
      "enabled": false
    },
    {
      "matchPackageNames": ["docker-compose"],
      "automerge": true
    },
    {
      "matchFileNames": ["apps/neko/firefox/*.yml"],
      "allowedVersions": "firefox"
    },
    {
      "matchFileNames": ["apps/music-tag-web/2.*/*.yml"],
      "allowedVersions": "/^2.*/"
    },
    {
      "matchFileNames": ["apps/act_runner/5.*/*.yml"],
      "versioning": "docker",
      "allowedVersions": ">=5.0.0 <6.0.0",
      "automerge": false
    },
    {
      "matchFileNames": ["apps/magpie/0.*/*.yml"],
      "allowedVersions": "/^0\\.1\\.\\d+$/"
    }
  ]
}
